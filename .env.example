# Скопируйте в .env и заполните. Файл .env в репозиторий НЕ коммитится.

# --- API ---
DATABASE_URL=postgres://blizkie:CHANGE_ME@localhost:5432/blizkie
PORT=8080
# Токен для выгрузки всех результатов испытаний (GET /v1/admin/export). Не короче 24 символов.
ADMIN_TOKEN=
# Если задан — регистрация телефона требует этот ключ (защита публичного тестового сервера)
REGISTRATION_KEY=
# Сколько хранить точки (часов). По умолчанию 24. Для длинных испытаний можно 72 — затем удалить.
LOCATION_TTL_HOURS=24
DIAG_TTL_DAYS=7
PAIR_TTL_DAYS=14
REFRESH_TIMEOUT_MS=90000
# none | expo  (expo — после настройки FCM/APNs в проекте Expo, этап D)
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=

# --- Сборка мобильного приложения ---
# Адрес сервера, подставляемый в сборку (можно сменить в приложении)
EXPO_PUBLIC_API_URL=https://your-server.example
IOS_BUNDLE_ID=app.blizkie.p0
ANDROID_PACKAGE=app.blizkie.p0
EAS_PROJECT_ID=

# --- VPS-развёртывание (deploy/vps) ---
# Домен для HTTPS. Без своего домена: <IP-сервера>.sslip.io, например 203.0.113.10.sslip.io
DOMAIN=
POSTGRES_PASSWORD=
